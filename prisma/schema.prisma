// prisma\schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
    id            String   @id @default(cuid())
    email         String   @unique
    password      String
    createdAt     DateTime @default(now())
}

model Organization {
    id        String   @id @default(cuid())
    name      String
    slug      String   @unique
    createdAt DateTime @default(now())
}

